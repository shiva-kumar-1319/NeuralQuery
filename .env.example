# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/neuralquery

# AI API Key (Get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# File Upload Settings
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# CORS Settings (update for production)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Note: DuckDuckGo search requires NO API key! It's completely free.
